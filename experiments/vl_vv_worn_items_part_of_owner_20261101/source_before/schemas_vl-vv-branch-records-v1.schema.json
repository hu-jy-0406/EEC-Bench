{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VL/VV branch pipeline canonical records v1 (detection issues, entity table, reviewed units)",
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "issue": {
      "type": "object",
      "required": [
        "issue_id",
        "branch",
        "scope",
        "subcategory",
        "description",
        "shot_ids",
        "entity_refs",
        "key_evidence",
        "confidence",
        "v_l_detail",
        "v_v_detail"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "enum": [
            "v_l",
            "v_v"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "v_l",
            "within_shot",
            "cross_shot"
          ]
        },
        "subcategory": {
          "type": "string",
          "enum": [
            "presence_count",
            "attribute",
            "action_state",
            "interaction",
            "spatial_orientation",
            "setting_environment",
            "camera_composition",
            "style_rendering",
            "stated_continuity",
            "shot_structure",
            "identity_drift",
            "appearance_drift",
            "action_discontinuity",
            "object_instability",
            "presence_instability",
            "background_drift",
            "physical_integrity",
            "relation_break",
            "unintended_cut",
            "rendering_instability",
            "character_identity",
            "character_appearance",
            "object_identity",
            "setting_background",
            "environment_lighting",
            "rendering_style",
            "instance_count",
            "state_action_continuity",
            "spatial_continuity"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity_key",
              "role"
            ],
            "properties": {
              "entity_key": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "subject",
                  "context"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "key_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "shot_id",
              "frame_id",
              "entity_keys",
              "observation"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_id": {
                "type": "integer",
                "minimum": 0
              },
              "entity_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "observation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "v_l_detail": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "requirement_quotes",
                "expected",
                "occurrences",
                "template_row_ids"
              ],
              "properties": {
                "requirement_quotes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "source",
                      "shot_id",
                      "quote"
                    ],
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "global_prompt",
                          "shot_prompt",
                          "contract",
                          "shot_transitions"
                        ]
                      },
                      "shot_id": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "minLength": 1
                          }
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                },
                "occurrences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "shot_id",
                      "row_ids",
                      "frame_refs",
                      "observed",
                      "mismatch"
                    ],
                    "properties": {
                      "shot_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "row_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "frame_refs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "shot_id",
                            "frame_id"
                          ],
                          "properties": {
                            "shot_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "frame_id": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "observed": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mismatch": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "template_row_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "v_v_detail": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "change_ids",
                "changes",
                "checklist_items"
              ],
              "properties": {
                "change_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "change_id",
                      "scope",
                      "shot_ids",
                      "aspect",
                      "description",
                      "frame_refs",
                      "judgment"
                    ],
                    "additionalProperties": true
                  },
                  "minItems": 1
                },
                "checklist_items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "entity_key",
        "global_entity_id",
        "source",
        "name",
        "description",
        "partition",
        "prompt_entity_id",
        "frame_refs",
        "provenance",
        "basis_type",
        "contract_label",
        "quote",
        "part_of",
        "note"
      ],
      "properties": {
        "entity_key": {
          "type": "string",
          "minLength": 1
        },
        "global_entity_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "detection_ledger",
            "added_by_vl_detection",
            "added_by_vv_detection"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "partition": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "prompt_bound",
                "prompt_unbound"
              ]
            }
          ]
        },
        "prompt_entity_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "frame_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "shot_id",
              "frame_id"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_id": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "prompt_bound",
                "prompt_unbound",
                "uncertain"
              ]
            }
          ]
        },
        "basis_type": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "contract_entity",
                "prompt_quote",
                "part_of_entity",
                "not_in_text",
                "ambiguous_text"
              ]
            }
          ]
        },
        "contract_label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "part_of": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": [
        "unit_id",
        "parent_issue_id",
        "branch",
        "scope",
        "subcategory",
        "description",
        "original_description",
        "revision",
        "revision_note",
        "split",
        "split_reason",
        "shot_ids",
        "verdict",
        "basis",
        "confidence",
        "evidence",
        "assessment",
        "entity_refs",
        "v_l_detail",
        "v_v_detail"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_issue_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "enum": [
            "v_l",
            "v_v"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "v_l",
            "within_shot",
            "cross_shot"
          ]
        },
        "subcategory": {
          "type": "string",
          "enum": [
            "presence_count",
            "attribute",
            "action_state",
            "interaction",
            "spatial_orientation",
            "setting_environment",
            "camera_composition",
            "style_rendering",
            "stated_continuity",
            "shot_structure",
            "identity_drift",
            "appearance_drift",
            "action_discontinuity",
            "object_instability",
            "presence_instability",
            "background_drift",
            "physical_integrity",
            "relation_break",
            "unintended_cut",
            "rendering_instability",
            "character_identity",
            "character_appearance",
            "object_identity",
            "setting_background",
            "environment_lighting",
            "rendering_style",
            "instance_count",
            "state_action_continuity",
            "spatial_continuity"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "original_description": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "enum": [
            "unchanged",
            "clarified"
          ]
        },
        "revision_note": {
          "type": "string"
        },
        "split": {
          "type": "boolean"
        },
        "split_reason": {
          "type": "string"
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "confirmed",
            "rejected",
            "uncertain"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "requirement_violated",
            "requirement_absent",
            "requirement_not_applicable",
            "requirement_satisfied",
            "visual_difference_only",
            "not_verifiable",
            "inconsistency_confirmed",
            "consistent_in_frames",
            "normal_change",
            "not_expected_to_match",
            "text_violation_only",
            "not_verifiable"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "shot_id",
              "frame_id",
              "role",
              "observation"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_id": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "type": "string",
                "enum": [
                  "supports",
                  "refutes",
                  "context"
                ]
              },
              "observation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity_key",
              "role",
              "provenance",
              "basis_note"
            ],
            "properties": {
              "entity_key": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "subject",
                  "context"
                ]
              },
              "provenance": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "prompt_bound",
                      "prompt_unbound",
                      "uncertain"
                    ]
                  }
                ]
              },
              "basis_note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "v_l_detail": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "requirement_quote",
                "requirement_quote_verified",
                "requirement_applies"
              ],
              "properties": {
                "requirement_quote": {
                  "type": "object",
                  "required": [
                    "source",
                    "shot_id",
                    "quote"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "global_prompt",
                        "shot_prompt",
                        "contract",
                        "shot_transitions"
                      ]
                    },
                    "shot_id": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "minLength": 1
                        }
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "requirement_quote_verified": {
                  "type": "boolean"
                },
                "requirement_applies": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "v_v_detail": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "comparison",
                "normal_cause",
                "normal_cause_note"
              ],
              "properties": {
                "comparison": {
                  "type": "string",
                  "minLength": 1
                },
                "normal_cause": {
                  "type": "string",
                  "enum": [
                    "none",
                    "camera_motion",
                    "viewpoint_change",
                    "described_action",
                    "visible_action",
                    "occlusion_or_framing",
                    "lighting_cause",
                    "time_skip",
                    "different_entity",
                    "required_transition",
                    "cut_timing_offset",
                    "image_quality"
                  ]
                },
                "normal_cause_note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
