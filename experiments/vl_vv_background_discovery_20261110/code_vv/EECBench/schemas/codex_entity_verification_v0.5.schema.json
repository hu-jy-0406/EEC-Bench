{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eecbench.local/schemas/codex_entity_verification_v0.5.schema.json",
  "title": "Single-shot boxed inventory entity verification v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "shot_id", "verifier_id", "reviews", "warnings"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["single_shot_inventory_first_boxed_granularity_v0.5"]
    },
    "shot_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "reviews": {
      "type": "array",
      "items": {"$ref": "#/$defs/review"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "coarse_locator", "support_quality"],
      "properties": {
        "frame_id": {"type": "integer", "minimum": 0},
        "coarse_locator": {"type": "string", "minLength": 1},
        "support_quality": {
          "type": "string",
          "enum": ["strong", "moderate", "weak"]
        }
      }
    },
    "physical_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "anonymous_proposal_ids",
        "existence_judgment",
        "salience_judgment",
        "evidence"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "anonymous_proposal_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "existence_judgment": {
          "type": "string",
          "enum": ["confirmed", "rejected", "uncertain"]
        },
        "salience_judgment": {
          "type": "string",
          "enum": ["graph_worthy", "background_integrated", "ambiguous"]
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "pairwise_physical_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id_a",
        "unit_id_b",
        "frame_id",
        "unit_a_coarse_locator",
        "unit_b_coarse_locator",
        "support_quality"
      ],
      "properties": {
        "unit_id_a": {"type": "string", "minLength": 1},
        "unit_id_b": {"type": "string", "minLength": 1},
        "frame_id": {"type": "integer", "minimum": 0},
        "unit_a_coarse_locator": {"type": "string", "minLength": 1},
        "unit_b_coarse_locator": {"type": "string", "minLength": 1},
        "support_quality": {
          "type": "string",
          "enum": ["strong", "moderate", "weak"]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "existence_judgment",
        "salience_judgment",
        "same_instance_with_cluster_ids",
        "graph_partition_judgment",
        "same_graph_node_with_cluster_ids",
        "observed_independence_evidence",
        "intra_cluster_split_judgment",
        "proposed_physical_units",
        "pairwise_physical_separation_evidence",
        "evidence",
        "reason"
      ],
      "properties": {
        "cluster_id": {"type": "string", "minLength": 1},
        "existence_judgment": {
          "type": "string",
          "enum": ["confirmed", "rejected", "uncertain"]
        },
        "salience_judgment": {
          "type": "string",
          "enum": ["graph_worthy", "background_integrated", "ambiguous"]
        },
        "same_instance_with_cluster_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "graph_partition_judgment": {
          "type": "string",
          "enum": [
            "keep_as_separate_node",
            "merge_into_compact_composite",
            "uncertain"
          ]
        },
        "same_graph_node_with_cluster_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "observed_independence_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "intra_cluster_split_judgment": {
          "type": "string",
          "enum": [
            "not_reviewed",
            "keep_single_physical_instance",
            "split_into_multiple_physical_instances",
            "uncertain"
          ]
        },
        "proposed_physical_units": {
          "type": "array",
          "items": {"$ref": "#/$defs/physical_unit"}
        },
        "pairwise_physical_separation_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/pairwise_physical_separation"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
