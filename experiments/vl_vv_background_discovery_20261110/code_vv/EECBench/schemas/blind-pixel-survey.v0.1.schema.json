{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "regions", "tracks", "region_relations", "coverage_notes"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["blind_pixel_survey_v0.1"]},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "region_relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "coverage_notes": {"type": "string"}
  },
  "$defs": {
    "scope": {"type": "string", "enum": ["whole", "part", "collection", "unknown"]},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "frame_id", "view_id", "visual_description", "scope_kind", "boundary_status", "bbox_xyxy"],
      "properties": {
        "region_id": {"type": "string"},
        "frame_id": {"type": "integer"},
        "view_id": {"type": "string"},
        "visual_description": {"type": "string"},
        "scope_kind": {"$ref": "#/$defs/scope"},
        "boundary_status": {"type": "string", "enum": ["clear", "partial", "uncertain"]},
        "bbox_xyxy": {"anyOf": [{"type": "array", "items": {"type": "number"}}, {"type": "null"}]}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "visual_description", "scope_kind", "frame_states"],
      "properties": {
        "track_id": {"type": "string"},
        "visual_description": {"type": "string"},
        "scope_kind": {"$ref": "#/$defs/scope"},
        "frame_states": {"type": "array", "items": {"$ref": "#/$defs/frame_state"}}
      }
    },
    "frame_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "visibility", "region_ids", "note"],
      "properties": {
        "frame_id": {"type": "integer"},
        "visibility": {"type": "string", "enum": ["visible", "occluded", "out_of_view", "uncertain"]},
        "region_ids": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id_a", "region_id_b", "identity", "scope_relation", "visual_evidence"],
      "properties": {
        "region_id_a": {"type": "string"},
        "region_id_b": {"type": "string"},
        "identity": {"type": "string", "enum": ["same", "distinct", "uncertain"]},
        "scope_relation": {"type": "string", "enum": ["comparable", "a_whole_b_part", "a_part_b_whole", "a_collection_b_member", "a_member_b_collection", "unknown"]},
        "visual_evidence": {"type": "string"}
      }
    }
  }
}
