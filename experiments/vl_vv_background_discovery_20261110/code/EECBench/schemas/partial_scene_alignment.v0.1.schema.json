{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "a_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "b_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "unmatched",
              "ambiguous",
              "scope_mismatch"
            ]
          },
          "evidence_a": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "evidence_b": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "group_id",
          "a_ids",
          "b_ids",
          "status",
          "evidence_a",
          "evidence_b",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a_anchor": {
            "type": "string",
            "minLength": 1
          },
          "b_anchor": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "aligned",
              "ambiguous"
            ]
          },
          "orientation": {
            "type": "string",
            "enum": [
              "same",
              "reversed",
              "unknown"
            ]
          },
          "evidence_a": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "evidence_b": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "a_anchor",
          "b_anchor",
          "status",
          "orientation",
          "evidence_a",
          "evidence_b",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "groups",
    "anchors"
  ],
  "additionalProperties": false
}
