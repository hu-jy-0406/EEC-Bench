{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "presence_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "expected_region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observation": {
                  "type": "string",
                  "enum": [
                    "seen",
                    "verified_absent",
                    "out_of_view",
                    "occluded",
                    "insufficient_detail",
                    "unknown"
                  ]
                },
                "gates": {
                  "type": "object",
                  "properties": {
                    "source_presence_reliable": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    },
                    "source_location_reliable": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    },
                    "anchor_alignment_reliable": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    },
                    "region_in_view": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    },
                    "region_unoccluded": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    },
                    "detail_sufficient": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    },
                    "all_hypotheses_testable": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "source_presence_reliable",
                    "source_location_reliable",
                    "anchor_alignment_reliable",
                    "region_in_view",
                    "region_unoccluded",
                    "detail_sufficient",
                    "all_hypotheses_testable"
                  ],
                  "additionalProperties": false
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "expected_region_xyxy",
                "observation",
                "gates",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "query_id",
          "source_evidence",
          "frames"
        ],
        "additionalProperties": false
      }
    },
    "relation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "correspondence_reliable": {
            "type": "boolean"
          },
          "evidence_a": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "evidence_b": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_xyxy": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "frame_id",
                "region_xyxy",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "values_a": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "less",
                "overlapping",
                "greater"
              ]
            }
          },
          "values_b": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "less",
                "overlapping",
                "greater"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query_id",
          "correspondence_reliable",
          "evidence_a",
          "evidence_b",
          "values_a",
          "values_b",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "presence_checks",
    "relation_checks"
  ],
  "additionalProperties": false
}
