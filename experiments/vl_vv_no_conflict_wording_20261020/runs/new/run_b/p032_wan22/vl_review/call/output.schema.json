{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VL/VV issue review v6, V-L branch (confirmed / rejected / uncertain, split and clarify)",
  "type": "object",
  "required": [
    "protocol",
    "reviews"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "vl_vv_issue_review_v6_vl"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "action",
          "split_reason",
          "units"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "keep",
              "split"
            ]
          },
          "split_reason": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "unit_id",
                "description",
                "revision",
                "revision_note",
                "subcategory",
                "shot_ids",
                "requirement_quote",
                "requirement_applies",
                "verdict",
                "basis",
                "confidence",
                "evidence",
                "assessment"
              ],
              "properties": {
                "unit_id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "enum": [
                    "unchanged",
                    "clarified"
                  ]
                },
                "revision_note": {
                  "type": "string"
                },
                "subcategory": {
                  "type": "string",
                  "enum": [
                    "presence_count",
                    "attribute",
                    "action_state",
                    "interaction",
                    "spatial_orientation",
                    "setting_environment",
                    "camera_composition",
                    "style_rendering",
                    "stated_continuity",
                    "shot_structure"
                  ]
                },
                "shot_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "requirement_quote": {
                  "type": "object",
                  "required": [
                    "source",
                    "shot_id",
                    "quote"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "global_prompt",
                        "shot_prompt",
                        "contract",
                        "shot_transitions"
                      ]
                    },
                    "shot_id": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "minLength": 1
                        }
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "requirement_applies": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "confirmed",
                    "rejected",
                    "uncertain"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "requirement_violated",
                    "requirement_absent",
                    "requirement_not_applicable",
                    "requirement_satisfied",
                    "visual_difference_only",
                    "not_verifiable"
                  ]
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "shot_id",
                      "frame_id",
                      "role",
                      "observation"
                    ],
                    "properties": {
                      "shot_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "frame_id": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "supports",
                          "refutes",
                          "context"
                        ]
                      },
                      "observation": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "assessment": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
