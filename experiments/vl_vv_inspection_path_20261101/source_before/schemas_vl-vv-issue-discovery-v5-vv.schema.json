{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VL/VV issue discovery v5, V-V branch (checklist template)",
  "type": "object",
  "required": [
    "protocol",
    "checklist_audit",
    "shot_scan",
    "continuity_ledger",
    "boundary_checks",
    "observed_changes",
    "entity_register",
    "issues"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "vl_vv_issue_discovery_v5_vv"
    },
    "checklist_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "status",
          "note"
        ],
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "W1",
              "W2",
              "W3",
              "W4",
              "W5",
              "W6",
              "W7",
              "X1",
              "X2",
              "X3",
              "X4",
              "X5",
              "X6",
              "X7",
              "X8",
              "X9",
              "O1"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "checked",
              "not_applicable"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "shot_scan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "camera",
          "characters",
          "other",
          "change_ids"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "camera": {
            "type": "object",
            "required": [
              "setup",
              "movement",
              "note"
            ],
            "properties": {
              "setup": {
                "type": "string",
                "minLength": 1
              },
              "movement": {
                "type": "string",
                "enum": [
                  "none",
                  "smooth",
                  "reframe",
                  "jump"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity_key",
                "face",
                "hair_clothing",
                "action",
                "stable"
              ],
              "properties": {
                "entity_key": {
                  "type": "string",
                  "minLength": 1
                },
                "face": {
                  "type": "string",
                  "minLength": 1
                },
                "hair_clothing": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "stable": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "other": {
            "type": "string",
            "minLength": 1
          },
          "change_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "continuity_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_kind",
          "entity_keys",
          "name",
          "observations",
          "assessment",
          "change_ids"
        ],
        "properties": {
          "subject_kind": {
            "type": "string",
            "enum": [
              "character",
              "object",
              "setting",
              "style"
            ]
          },
          "entity_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shot_id",
                "frame_id",
                "signature"
              ],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "assessment": {
            "type": "string",
            "enum": [
              "consistent",
              "inconsistent",
              "uncertain"
            ]
          },
          "change_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "boundary_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_shot",
          "to_shot",
          "last_frame",
          "first_frame",
          "continuity",
          "change_ids"
        ],
        "properties": {
          "from_shot": {
            "type": "string",
            "minLength": 1
          },
          "to_shot": {
            "type": "string",
            "minLength": 1
          },
          "last_frame": {
            "type": "string",
            "minLength": 1
          },
          "first_frame": {
            "type": "string",
            "minLength": 1
          },
          "continuity": {
            "type": "string",
            "minLength": 1
          },
          "change_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "observed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "scope",
          "shot_ids",
          "aspect",
          "entity_keys",
          "description",
          "frame_refs",
          "judgment",
          "cause",
          "cause_basis",
          "cause_quote",
          "issue_id"
        ],
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "within_shot",
              "cross_shot"
            ]
          },
          "shot_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "aspect": {
            "type": "string",
            "enum": [
              "camera_position",
              "face_identity",
              "clothing_hair",
              "action_pose",
              "body_integrity",
              "object",
              "held_object_contact",
              "presence_count",
              "background_setting",
              "lighting_environment",
              "rendering",
              "spatial_layout"
            ]
          },
          "entity_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "frame_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shot_id",
                "frame_id"
              ],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "judgment": {
            "type": "string",
            "enum": [
              "normal",
              "abnormal",
              "uncertain"
            ]
          },
          "cause": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "enum": [
                  "camera_motion",
                  "viewpoint_change",
                  "described_action",
                  "visible_action",
                  "occlusion_or_framing",
                  "lighting_cause",
                  "time_skip",
                  "different_entity",
                  "required_transition",
                  "cut_timing_offset",
                  "image_quality"
                ]
              }
            ]
          },
          "cause_basis": {
            "type": "string"
          },
          "cause_quote": {
            "type": "string"
          },
          "issue_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "entity_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_key",
          "global_entity_id",
          "source",
          "name",
          "description",
          "frame_refs",
          "provenance",
          "basis_type",
          "contract_label",
          "quote",
          "part_of",
          "note"
        ],
        "properties": {
          "entity_key": {
            "type": "string",
            "minLength": 1
          },
          "global_entity_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "detection_ledger",
              "added_by_vv_detection"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "frame_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shot_id",
                "frame_id"
              ],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "provenance": {
            "type": "string",
            "enum": [
              "prompt_bound",
              "prompt_unbound",
              "uncertain"
            ]
          },
          "basis_type": {
            "type": "string",
            "enum": [
              "contract_entity",
              "prompt_quote",
              "part_of_entity",
              "not_in_text",
              "ambiguous_text"
            ]
          },
          "contract_label": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "part_of": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "scope",
          "subcategory",
          "description",
          "shot_ids",
          "change_ids",
          "entities",
          "key_evidence",
          "checklist_items",
          "confidence"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "within_shot",
              "cross_shot"
            ]
          },
          "subcategory": {
            "type": "string",
            "enum": [
              "identity_drift",
              "appearance_drift",
              "action_discontinuity",
              "object_instability",
              "presence_instability",
              "background_drift",
              "physical_integrity",
              "relation_break",
              "unintended_cut",
              "rendering_instability",
              "character_identity",
              "character_appearance",
              "object_identity",
              "setting_background",
              "environment_lighting",
              "rendering_style",
              "instance_count",
              "state_action_continuity",
              "spatial_continuity"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "shot_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "change_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity_key",
                "role"
              ],
              "properties": {
                "entity_key": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "subject",
                    "context"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "key_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shot_id",
                "frame_id",
                "entity_keys",
                "observation"
              ],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "entity_keys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "checklist_items": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "W1",
                "W2",
                "W3",
                "W4",
                "W5",
                "W6",
                "W7",
                "X1",
                "X2",
                "X3",
                "X4",
                "X5",
                "X6",
                "X7",
                "X8",
                "X9",
                "O1"
              ]
            },
            "minItems": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
