{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VL/VV issue review v5 model response (v4 + episode-wide entity descriptions)",
  "type": "object",
  "required": [
    "protocol",
    "reviews"
  ],
  "properties": {
    "protocol": {
      "const": "vl_vv_issue_review_v5",
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "issue_id",
        "v_l_review",
        "v_v_review",
        "critique",
        "evidence"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "v_l_review": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/label_review"
            }
          ]
        },
        "v_v_review": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/label_review"
            }
          ]
        },
        "critique": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": false
    },
    "label_review": {
      "type": "object",
      "required": [
        "verdict",
        "confidence",
        "assessment"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "confirmed",
            "rejected",
            "uncertain"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        "assessment": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "shot_id",
        "frame_id",
        "role",
        "observation"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "supports",
            "refutes",
            "context"
          ],
          "type": "string"
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
