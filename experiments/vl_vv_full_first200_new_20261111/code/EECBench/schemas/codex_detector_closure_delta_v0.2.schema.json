{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_version",
    "shot_id",
    "detector_id",
    "round_index",
    "accessed_input_paths",
    "additions",
    "novelty_checks",
    "coverage_audit",
    "warnings"
  ],
  "properties": {
    "stage_version": {
      "type": "string",
      "enum": [
        "single_shot_own_source_residual_closure_v0.2"
      ]
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "detector_id": {
      "type": "string",
      "minLength": 1
    },
    "round_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "accessed_input_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "additions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "novelty_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/closureNovelty"
      }
    },
    "coverage_audit": {
      "$ref": "#/$defs/closureAudit"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eecbench.local/schemas/codex_detector_closure_delta_v0.2.schema.json",
  "title": "Own-source append-only residual discovery delta v0.2",
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "frameIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "localIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pass2ResidualLocalIds": {
      "description": "Optional-in-content pass-2 provenance list; the field is required but may be empty and is independent of temporal added_local_ids.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spatialCellName": {
      "type": "string",
      "enum": [
        "upper_left",
        "upper_center",
        "upper_right",
        "middle_left",
        "middle_center",
        "middle_right",
        "lower_left",
        "lower_center",
        "lower_right"
      ]
    },
    "contentStratumName": {
      "type": "string",
      "enum": [
        "actors_and_independently_handled_objects",
        "freestanding_and_supported_objects",
        "containers_open_storage_and_bounded_collections",
        "fixed_architectural_and_mounted_objects",
        "peripheral_cropped_and_exterior_bounded_objects"
      ]
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "evidence_frame_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frame_ids": {
          "$ref": "#/$defs/frameIds"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "description"
      ],
      "properties": {
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "framePresence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "status",
        "description",
        "bbox_xyxy_normalized"
      ],
      "properties": {
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "visible",
            "absent",
            "occluded",
            "uncertain"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "bbox_xyxy_normalized": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "spatialCellReview": {
      "description": "One mandatory grid-cell review. represented_local_ids is a best-effort private cross-index: omissions are nonfatal, while every listed ID must name a final entity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "best_frame_id",
        "represented_local_ids"
      ],
      "properties": {
        "cell": {
          "$ref": "#/$defs/spatialCellName"
        },
        "best_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "represented_local_ids": {
          "$ref": "#/$defs/localIds"
        }
      }
    },
    "contentStratumReview": {
      "description": "One mandatory content-stratum review. represented_local_ids is a best-effort private cross-index: omissions are nonfatal, while every listed ID must name a final entity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum",
        "represented_local_ids"
      ],
      "properties": {
        "stratum": {
          "$ref": "#/$defs/contentStratumName"
        },
        "represented_local_ids": {
          "$ref": "#/$defs/localIds"
        }
      }
    },
    "temporalRevealCheck": {
      "description": "One mandatory adjacent-frame review. added_local_ids lists final entities newly revealed or materially confirmed by this pair and is independent of residual_added_local_ids.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earlier_frame_id",
        "later_frame_id",
        "newly_revealed_cells",
        "added_local_ids"
      ],
      "properties": {
        "earlier_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "later_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "newly_revealed_cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spatialCellName"
          }
        },
        "added_local_ids": {
          "$ref": "#/$defs/localIds"
        }
      }
    },
    "coverageAudit": {
      "description": "Private completion bookkeeping. Structural coverage and referenced-ID validity are strict; entity cross-index completeness is diagnostic and nonfatal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_frame_ids",
        "spatial_cells",
        "content_strata",
        "temporal_reveal_checks",
        "residual_added_local_ids"
      ],
      "properties": {
        "reviewed_frame_ids": {
          "$ref": "#/$defs/frameIds"
        },
        "spatial_cells": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/spatialCellReview"
          }
        },
        "content_strata": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/contentStratumReview"
          }
        },
        "temporal_reveal_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalRevealCheck"
          }
        },
        "residual_added_local_ids": {
          "$ref": "#/$defs/pass2ResidualLocalIds"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id",
        "proposed_name",
        "canonical_head",
        "entity_type",
        "granularity",
        "attributes",
        "evidence_frame_ids",
        "coarse_locators",
        "frame_presence",
        "self_confidence",
        "uncertainty_flags"
      ],
      "properties": {
        "local_id": {
          "type": "string",
          "minLength": 1
        },
        "proposed_name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_head": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "granularity": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "evidence_frame_ids": {
          "$ref": "#/$defs/frameIds"
        },
        "coarse_locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "frame_presence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/framePresence"
          }
        },
        "self_confidence": {
          "$ref": "#/$defs/confidence"
        },
        "uncertainty_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "closureFrameCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "cell",
        "existing_local_ids",
        "new_local_ids",
        "note"
      ],
      "properties": {
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "cell": {
          "$ref": "#/$defs/spatialCellName"
        },
        "existing_local_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "new_local_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closureEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "frame_id",
        "reviewed_edges",
        "new_local_ids",
        "note"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "enum": [
            "first_frame",
            "last_frame"
          ]
        },
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "top",
              "right",
              "bottom",
              "left"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "new_local_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closureTemporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earlier_frame_id",
        "later_frame_id",
        "revealed_new_local_ids",
        "disappearing_new_local_ids",
        "note"
      ],
      "properties": {
        "earlier_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "later_frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "revealed_new_local_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disappearing_new_local_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closureNovelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id",
        "nearby_existing_local_ids",
        "boundary_evidence",
        "separation_reason"
      ],
      "properties": {
        "local_id": {
          "type": "string",
          "minLength": 1
        },
        "nearby_existing_local_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          },
          "minItems": 1
        },
        "separation_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closureAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_frame_ids",
        "frame_cell_checks",
        "endpoint_checks",
        "temporal_checks"
      ],
      "properties": {
        "reviewed_frame_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "frame_cell_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closureFrameCell"
          },
          "minItems": 9
        },
        "endpoint_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closureEndpoint"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "temporal_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closureTemporal"
          }
        }
      }
    }
  }
}
