{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VL/VV issue review v1 model response",
  "type": "object",
  "required": ["protocol", "reviews"],
  "properties": {
    "protocol": {
      "const": "vl_vv_issue_review_v1",
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "issue_id",
        "verdict",
        "confidence",
        "critique",
        "prompt_assessment",
        "evidence"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": ["confirmed", "rejected", "uncertain"],
          "type": "string"
        },
        "confidence": {
          "enum": ["high", "medium", "low"],
          "type": "string"
        },
        "critique": {
          "type": "string",
          "minLength": 1
        },
        "prompt_assessment": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["shot_id", "frame_id", "role", "observation"],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": ["supports", "refutes", "context"],
          "type": "string"
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
