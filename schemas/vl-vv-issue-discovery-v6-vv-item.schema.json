{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VL/VV issue discovery v6, V-V branch (one checklist item per call)",
  "type": "object",
  "required": [
    "protocol",
    "checklist",
    "added_entities"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "vl_vv_issue_discovery_v6_vv_item"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "status",
          "note",
          "issues"
        ],
        "properties": {
          "item": {
            "type": "string",
            "enum": [
              "W1",
              "W2",
              "W3",
              "W4",
              "W5",
              "W6",
              "W7",
              "X1",
              "X2",
              "X3",
              "X4",
              "X5",
              "X6",
              "X7",
              "X8",
              "X9",
              "O1"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "checked",
              "not_applicable"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "issue_id",
                "scope",
                "subcategory",
                "description",
                "shot_ids",
                "entities",
                "key_evidence",
                "confidence"
              ],
              "properties": {
                "issue_id": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "within_shot",
                    "cross_shot"
                  ]
                },
                "subcategory": {
                  "type": "string",
                  "enum": [
                    "identity_drift",
                    "appearance_drift",
                    "action_discontinuity",
                    "object_instability",
                    "presence_instability",
                    "background_drift",
                    "physical_integrity",
                    "relation_break",
                    "unintended_cut",
                    "rendering_instability",
                    "other",
                    "character_identity",
                    "character_appearance",
                    "object_identity",
                    "setting_background",
                    "environment_lighting",
                    "rendering_style",
                    "instance_count",
                    "state_action_continuity",
                    "spatial_continuity"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "shot_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "entities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "entity_key",
                      "role"
                    ],
                    "properties": {
                      "entity_key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "subject",
                          "context"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "key_evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "shot_id",
                      "frame_id",
                      "entity_keys",
                      "observation"
                    ],
                    "properties": {
                      "shot_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "frame_id": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "entity_keys": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "observation": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "added_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_key",
          "name",
          "description",
          "frame_refs"
        ],
        "properties": {
          "entity_key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "frame_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "shot_id",
                "frame_id"
              ],
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_id": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
